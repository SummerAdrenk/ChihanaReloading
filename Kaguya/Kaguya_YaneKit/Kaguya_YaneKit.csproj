<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- 本工具目前只面向 Windows x64；限制 RID 可避免 Avalonia/SkiaSharp 复制 linux/osx/arm 等运行时资产。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 保持原有 bin/Release/net8.0-windows 输出路径，避免现有脚本因为 RID 子目录变化失效。 -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bk\**" />
    <Compile Remove="bk2\**" />
    <Compile Remove="bk3\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="4.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="Avalonia" Version="11.2.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ini\message_config.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
